<Window x:Class="FastOrder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="FastOrder"
        Height="950"
        Width="1450">

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="330"/>
        </Grid.RowDefinitions>


        <!-- TOP BAR -->

        <Grid Grid.Row="0"
              Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <WrapPanel Grid.Row="0">

            <Button x:Name="LoginButton"
                    Content="ورود به EasyTrader"
                    Width="160"
                    Height="36"
                    Margin="0,0,10,0"
                    Click="LoginButton_Click"/>

            <Button x:Name="MonitoringButton"
                    Content="فعال‌سازی Monitoring"
                    Width="170"
                    Height="36"
                    Margin="0,0,10,0"
                    Click="MonitoringButton_Click"/>

            <Button x:Name="LoginStatusButton"
                    Content="وضعیت ورود"
                    Width="120"
                    Height="36"
                    Margin="0,0,10,0"
                    Click="LoginStatusButton_Click"/>

            <Button x:Name="PreviewOrderButton"
                    Content="بررسی و تأیید سفارش"
                    Width="175"
                    Height="36"
                    Margin="0,0,10,0"
                    Click="PreviewOrderButton_Click"/>

            <Button x:Name="PrepareOrderButton"
                    Content="آماده‌سازی محلی"
                    Width="155"
                    Height="36"
                    Margin="0,0,10,0"
                    IsEnabled="False"
                    ToolTip="Payload و ترافیک طبیعی سایت را کنترل می‌کند؛ هیچ سفارشی ارسال نمی‌شود."
                    Click="PrepareOrderButton_Click"/>

            <Button x:Name="SendLiveOrderButton"
                    Content="زمان‌بندی ارسال واقعی"
                    Width="185"
                    Height="36"
                    Margin="0,0,10,0"
                    IsEnabled="False"
                    Background="#FFC62828"
                    Foreground="White"
                    FontWeight="SemiBold"
                    ToolTip="پس از تأیید نهایی، در بازه تعیین‌شده تا اولین پاسخ موفق تلاش می‌کند."
                    Click="SendLiveOrderButton_Click"/>

            <Button x:Name="CancelScheduledOrderButton"
                    Content="لغو زمان‌بندی"
                    Width="135"
                    Height="36"
                    Margin="0,0,10,0"
                    IsEnabled="False"
                    Background="#FF616161"
                    Foreground="White"
                    ToolTip="تلاش‌های بعدی را لغو می‌کند؛ عملیات ارسال‌شده قابل بازگردانی نیست."
                    Click="CancelScheduledOrderButton_Click"/>

            <Button x:Name="PauseButton"
                    Content="Pause Log"
                    Width="110"
                    Height="36"
                    Margin="0,0,10,0"
                    Click="PauseButton_Click"/>

            <Button x:Name="ClearButton"
                    Content="Clear Log"
                    Width="110"
                    Height="36"
                    Margin="0,0,10,0"
                    Click="ClearButton_Click"/>

            <Button x:Name="ReloadButton"
                    Content="بارگذاری مجدد"
                    Width="130"
                    Height="36"
                    Margin="0,0,10,0"
                    Click="ReloadButton_Click"/>

            </WrapPanel>

            <TextBlock x:Name="StatusTextBlock"
                       Grid.Row="1"
                       Text="در حال آماده‌سازی..."
                       VerticalAlignment="Center"
                       Margin="0,8,0,0"
                       FontSize="15"/>

        </Grid>


        <!-- WEBVIEW -->

        <wv2:WebView2 x:Name="Browser"
                      Grid.Row="1"
                      NavigationStarting="Browser_NavigationStarting"
                      NavigationCompleted="Browser_NavigationCompleted"/>


        <!-- LOG AREA -->

        <Grid Grid.Row="2"
              Margin="0,10,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1.3*"/>
            </Grid.ColumnDefinitions>


            <!-- LIVE LOG -->

            <GroupBox Grid.Column="0"
                      Header="Live Network Log"
                      Margin="0,0,5,0">

                <TextBox x:Name="LogTextBox"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         FontSize="12"
                         Padding="5"/>

            </GroupBox>


            <!-- IMPORTANT API -->

            <GroupBox Grid.Column="1"
                      Header="Important API"
                      Margin="5,0,0,0">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBox x:Name="ImportantApiTextBox"
                             Grid.Row="0"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             FontSize="12"
                             Padding="5"/>

                    <Button x:Name="ClearImportantButton"
                            Grid.Row="1"
                            Content="پاک کردن Important API"
                            Height="30"
                            Margin="5"
                            Click="ClearImportantButton_Click"/>
                </Grid>

            </GroupBox>

        </Grid>

    </Grid>

</Window>
