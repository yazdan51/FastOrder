<Window x:Class="FastOrder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="FastOrder"
        Width="1280"
        Height="720"
        MinWidth="1040"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#FFF3F5F7"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <Style x:Key="SectionTitleStyle"
               TargetType="TextBlock">
            <Setter Property="Margin"
                    Value="0,2,0,10"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Foreground"
                    Value="#FF263238"/>
        </Style>

        <Style x:Key="ControlButtonStyle"
               TargetType="Button">
            <Setter Property="MinHeight"
                    Value="38"/>
            <Setter Property="Margin"
                    Value="0,0,0,8"/>
            <Setter Property="Padding"
                    Value="12,6"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
        </Style>

        <Style x:Key="PanelBorderStyle"
               TargetType="Border">
            <Setter Property="Background"
                    Value="White"/>
            <Setter Property="BorderBrush"
                    Value="#FFD7DDE3"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="CornerRadius"
                    Value="6"/>
        </Style>

        <Style x:Key="PanelExpanderStyle"
               TargetType="Expander">
            <Setter Property="IsExpanded"
                    Value="True"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Stretch"/>
        </Style>

        <Style x:Key="SectionExpanderStyle"
               TargetType="Expander"
               BasedOn="{StaticResource PanelExpanderStyle}">
            <Setter Property="Margin"
                    Value="0,0,0,6"/>
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   Margin="0,2,0,6"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#FF263238"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Background"
                    Value="White"/>
            <Setter Property="BorderBrush"
                    Value="#FFD7DDE3"/>
            <Setter Property="Padding"
                    Value="6"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Padding"
                    Value="8,6"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding"
                    Value="8,5"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition x:Name="MainAreaRow"
                           Height="*"
                           MinHeight="220"/>
            <RowDefinition x:Name="MainSessionSplitterRow"
                           Height="6"/>
            <RowDefinition x:Name="SessionAreaRow"
                           Height="150"
                           MinHeight="120"
                           MaxHeight="300"/>
            <RowDefinition x:Name="SessionLogSplitterRow"
                           Height="6"/>
            <RowDefinition x:Name="LogAreaRow"
                           Height="190"
                           MinHeight="120"
                           MaxHeight="380"/>
        </Grid.RowDefinitions>

        <!-- Non-visual targets retained for existing status and broker-route logic. -->

        <Grid Grid.Row="0"
              Visibility="Collapsed"
              IsHitTestVisible="False">
            <TextBlock x:Name="BrokerRouteTextBlock"
                       Text="مسیر رسمی کارگزاری انتخاب‌شده"/>
            <TextBlock x:Name="StatusTextBlock"
                       Text="در حال آماده‌سازی..."/>
        </Grid>

        <!-- RESPONSIVE CONTROL PANEL + WEBVIEW -->

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ControlPanelColumn"
                                  Width="300"
                                  MinWidth="260"
                                  MaxWidth="440"/>
                <ColumnDefinition x:Name="MainAreaSplitterColumn"
                                  Width="6"/>
                <ColumnDefinition x:Name="BrokerWebViewColumn"
                                  Width="*"
                                  MinWidth="460"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="12,8"
                    Style="{StaticResource PanelBorderStyle}">
                <Expander x:Name="ControlPanelExpander"
                          Style="{StaticResource PanelExpanderStyle}"
                          IsExpanded="True"
                          AutomationProperties.Name="پنل کنترل">
                    <Expander.Header>
                        <TextBlock Text="پنل کنترل"
                                   Margin="6,2,0,6"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#FF263238"
                                   FlowDirection="RightToLeft"/>
                    </Expander.Header>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="True">
                        <StackPanel FlowDirection="RightToLeft">
                            <Expander Header="اتصال و نشست"
                                      Style="{StaticResource SectionExpanderStyle}"
                                      AutomationProperties.Name="اتصال و نشست">
                                <StackPanel>

                        <TextBlock Text="کارگزاری:"
                                   Margin="0,0,0,5"
                                   Foreground="#FF455A64"
                                   FontWeight="SemiBold"/>

                        <ComboBox x:Name="BrokerSelectionComboBox"
                                  MinHeight="34"
                                  Margin="0,0,0,8"
                                  Padding="8,4"
                                  DisplayMemberPath="DisplayName"
                                  SelectionChanged="BrokerSelectionComboBox_SelectionChanged"
                                  AutomationProperties.Name="انتخاب کارگزاری"
                                  ToolTip="کارگزاری را پیش از ورود و آماده‌سازی سفارش انتخاب کنید."/>

                        <Button x:Name="LoginButton"
                                Content="ورود به کارگزاری"
                                Style="{StaticResource ControlButtonStyle}"
                                Click="LoginButton_Click"/>

                        <Button x:Name="MonitoringButton"
                                Content="فعال‌سازی Monitoring"
                                Visibility="Collapsed"
                                Style="{StaticResource ControlButtonStyle}"
                                Click="MonitoringButton_Click"/>

                        <Button x:Name="LoginStatusButton"
                                Content="وضعیت ورود"
                                Visibility="Collapsed"
                                Style="{StaticResource ControlButtonStyle}"
                                Click="LoginStatusButton_Click"/>

                        <Button x:Name="ReloadButton"
                                Content="بارگذاری مجدد"
                                Visibility="Collapsed"
                                Style="{StaticResource ControlButtonStyle}"
                                Click="ReloadButton_Click"/>

                                </StackPanel>
                            </Expander>

                            <Expander Header="ارسال زمان‌بندی‌شده"
                                      Style="{StaticResource SectionExpanderStyle}"
                                      AutomationProperties.Name="ارسال زمان‌بندی‌شده">
                                <StackPanel>

                        <TextBlock Text="سمت سفارش:"
                                   Margin="0,0,0,5"
                                   Foreground="#FF455A64"
                                   FontWeight="SemiBold"/>

                        <StackPanel Margin="0,0,0,8"
                                    Orientation="Horizontal"
                                    FlowDirection="RightToLeft">
                            <RadioButton x:Name="ScheduledClickBuyRadioButton"
                                         Content="خرید"
                                         GroupName="ScheduledClickSide"
                                         Margin="0,0,18,0"
                                         AutomationProperties.Name="سمت خرید"
                                         Click="ScheduledClickSideRadioButton_Click"/>
                            <RadioButton x:Name="ScheduledClickSellRadioButton"
                                         Content="فروش"
                                         GroupName="ScheduledClickSide"
                                         AutomationProperties.Name="سمت فروش"
                                         Click="ScheduledClickSideRadioButton_Click"/>
                        </StackPanel>

                        <TextBlock Text="تعداد سفارش:"
                                   Margin="0,0,0,5"
                                   Foreground="#FF455A64"
                                   FontWeight="SemiBold"/>

                        <TextBox x:Name="ScheduledClickCountTextBox"
                                 MinHeight="34"
                                 Margin="0,0,0,8"
                                 Padding="8,5"
                                 FlowDirection="LeftToRight"
                                 TextAlignment="Right"
                                 AutomationProperties.Name="تعداد سفارش"
                                 ToolTip="تعداد کلیک‌های رسمی سمت انتخاب‌شده؛ این مقدار تعداد سهم نیست."/>

                        <StackPanel Margin="0,0,0,8">
                            <TextBlock x:Name="ExchangeClockTextBlock"
                                       Text=""
                                       MinWidth="205"
                                       HorizontalAlignment="Stretch"
                                       TextAlignment="Right"
                                       FlowDirection="LeftToRight"
                                       FontFamily="Consolas"
                                       FontSize="16"
                                       FontWeight="ExtraBold"
                                       Foreground="#FFEF6C00"
                                       AutomationProperties.Name="زمان جاری مرکز معاملات"/>
                        </StackPanel>

                        <TextBlock Text="زمان شروع (HH:mm:ss.fff):"
                                   Margin="0,0,0,5"
                                   Foreground="#FF455A64"
                                   FontWeight="SemiBold"/>

                        <TextBox x:Name="ScheduledClickStartTimeTextBox"
                                 MinHeight="34"
                                 Margin="0,0,0,8"
                                 Padding="8,5"
                                 FlowDirection="LeftToRight"
                                 TextAlignment="Right"
                                 AutomationProperties.Name="زمان شروع"
                                 ToolTip="زمان مرکز معاملات با قالب HH:mm:ss.fff"/>

                        <Button x:Name="StartScheduledClickButton"
                                Content="شروع ارسال زمان‌بندی‌شده"
                                Style="{StaticResource ControlButtonStyle}"
                                Background="#FFC62828"
                                BorderBrush="#FFB71C1C"
                                Foreground="White"
                                FontWeight="SemiBold"
                                ToolTip="پس از تأیید صریح، فرم رسمی سمت انتخاب‌شده را بدون خواندن یا تغییر مقادیر کلیک می‌کند."
                                Click="StartScheduledClickButton_Click"/>

                        <Button x:Name="CancelScheduledOrderButton"
                                Content="لغو نشست"
                                Style="{StaticResource ControlButtonStyle}"
                                IsEnabled="False"
                                Background="#FF616161"
                                BorderBrush="#FF424242"
                                Foreground="White"
                                ToolTip="تلاش‌های بعدی را لغو می‌کند؛ عملیات ارسال‌شده قابل بازگردانی نیست."
                                Click="CancelScheduledOrderButton_Click"/>

                                </StackPanel>
                            </Expander>

                            <Expander Header="ابزارهای بررسی"
                                      Style="{StaticResource SectionExpanderStyle}"
                                      AutomationProperties.Name="ابزارهای بررسی">

                        <Button x:Name="WebViewTimingTestButton"
                                Content="تست زمان‌بندی WebView2"
                                Visibility="Collapsed"
                                Style="{StaticResource ControlButtonStyle}"
                                ToolTip="فقط زمان اجرای JavaScript را اندازه‌گیری می‌کند؛ هیچ کلیک، POST یا تغییر فرم انجام نمی‌شود."
                                Click="WebViewTimingTestButton_Click"/>

                            </Expander>

                            <Expander Header="نمایش گزارش"
                                      Style="{StaticResource SectionExpanderStyle}"
                                      AutomationProperties.Name="نمایش گزارش">
                                <StackPanel>

                        <Button x:Name="PauseButton"
                                Content="Pause Log"
                                Style="{StaticResource ControlButtonStyle}"
                                Click="PauseButton_Click"/>

                        <Button x:Name="ClearButton"
                                Content="Clear Log"
                                Style="{StaticResource ControlButtonStyle}"
                                Click="ClearButton_Click"/>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Expander>
            </Border>

            <GridSplitter x:Name="ControlPanelGridSplitter"
                          Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          ShowsPreview="True"
                          Background="Transparent"
                          ToolTip="برای تغییر عرض پنل کنترل بکشید"/>

            <Border Grid.Column="2"
                    Style="{StaticResource PanelBorderStyle}"
                    ClipToBounds="True">
                <Expander x:Name="BrokerWebViewExpander"
                          Style="{StaticResource PanelExpanderStyle}"
                          IsExpanded="True"
                          AutomationProperties.Name="نمای کارگزاری">
                    <Expander.Header>
                        <TextBlock x:Name="BrokerWebViewTitleTextBlock"
                                   Text="کارگزاری انتخاب‌شده"
                                   Margin="8,6,0,6"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#FF263238"
                                   FlowDirection="RightToLeft"/>
                    </Expander.Header>

                    <Grid>

                        <wv2:WebView2 x:Name="Browser"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  NavigationStarting="Browser_NavigationStarting"
                                  NavigationCompleted="Browser_NavigationCompleted"/>

                        <Border x:Name="OfficialUiDispatcherOverlay"
                            Panel.ZIndex="10"
                            Background="#990B1720"
                            Visibility="Collapsed"
                            AutomationProperties.Name="عملیات کنترل‌شده کارگزاری">
                        <Border HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Padding="24,16"
                                CornerRadius="8"
                                Background="#EFFFFFFF">
                            <StackPanel HorizontalAlignment="Center">
                                <ProgressBar Width="220"
                                             Height="5"
                                             IsIndeterminate="True"/>
                                <TextBlock x:Name="OfficialUiDispatcherOverlayText"
                                           Margin="0,12,0,0"
                                           Text="در حال اجرای عملیات رسمی کارگزاری..."
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#FF263238"/>
                            </StackPanel>
                        </Border>
                        </Border>
                    </Grid>
                </Expander>
            </Border>
        </Grid>

        <GridSplitter x:Name="MainSessionGridSplitter"
                      Grid.Row="2"
                      Height="6"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      ResizeDirection="Rows"
                      ResizeBehavior="PreviousAndNext"
                      ShowsPreview="True"
                      Background="Transparent"
                      ToolTip="برای تغییر ارتفاع فهرست نشست‌ها بکشید"/>

        <!-- ORDER SESSIONS -->

        <Border Grid.Row="3"
                Margin="0,4,0,0"
                Style="{StaticResource PanelBorderStyle}"
                ClipToBounds="True">
            <Expander x:Name="SessionPanelExpander"
                      Style="{StaticResource PanelExpanderStyle}"
                      IsExpanded="False"
                      AutomationProperties.Name="نشست‌های کلیک زمان‌بندی‌شده">
                <Expander.Header>
                    <Grid Margin="8,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="نشست‌های کلیک زمان‌بندی‌شده"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#FF263238"
                                   FlowDirection="RightToLeft"/>

                        <TextBlock Grid.Column="1"
                                   Text="یک کلیک رسمی سمت انتخاب‌شده در هر اسلات یک‌ثانیه‌ای"
                                   Margin="18,0,0,0"
                                   HorizontalAlignment="Right"
                                   FlowDirection="RightToLeft"
                                   Foreground="#FF607D8B"
                                   FontSize="12"/>
                    </Grid>
                </Expander.Header>

                <DataGrid x:Name="SessionDataGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="True"
                          CanUserResizeColumns="True"
                          CanUserResizeRows="False"
                          EnableRowVirtualization="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0,1,0,0"
                          BorderBrush="#FFD7DDE3"
                          RowHeaderWidth="0"
                          AlternatingRowBackground="#FFF8FAFB"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          FlowDirection="RightToLeft"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          SelectionChanged="SessionDataGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#"
                                            Binding="{Binding CreationSequence}"
                                            Width="48"/>
                        <DataGridTextColumn Header="کارگزاری"
                                            Binding="{Binding BrokerDisplayName}"
                                            MinWidth="110"
                                            Width="Auto"/>
                        <DataGridTextColumn Header="سمت"
                                            Binding="{Binding SideDisplay}"
                                            MinWidth="64"
                                            Width="Auto"/>
                        <DataGridTextColumn Header="وضعیت"
                                            Binding="{Binding StateDisplay}"
                                            MinWidth="105"
                                            Width="Auto"/>
                        <DataGridTextColumn Header="تعداد کلیک"
                                            Binding="{Binding TotalClickCountDisplay}"
                                            MinWidth="78"
                                            Width="Auto"/>
                        <DataGridTextColumn Header="کلیک‌شده"
                                            Binding="{Binding ClickedCountDisplay}"
                                            MinWidth="88"
                                            Width="Auto"/>
                        <DataGridTextColumn Header="باقی‌مانده"
                                            Binding="{Binding RemainingClickCountDisplay}"
                                            MinWidth="88"
                                            Width="Auto"/>
                        <DataGridTextColumn Header="شروع"
                                            Binding="{Binding StartTimeDisplay}"
                                            MinWidth="78"
                                            Width="Auto"/>
                        <DataGridTextColumn Header="بعدی"
                                            Binding="{Binding NextDueDisplay}"
                                            MinWidth="100"
                                            Width="Auto"/>
                        <DataGridTextColumn Header="آخرین وضعیت"
                                            Binding="{Binding LastStatus}"
                                            MinWidth="180"
                                            Width="2*"/>
                        <DataGridTemplateColumn Header="عملیات"
                                                MinWidth="74"
                                                Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                FlowDirection="RightToLeft">
                                        <Button Content="لغو"
                                                Margin="2"
                                                Padding="8,3"
                                                ToolTip="فقط همین نشست را لغو می‌کند؛ کلیک انجام‌شده قابل بازگردانی نیست."
                                                Click="CancelScheduledClickSessionButton_Click"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Expander>
        </Border>

        <GridSplitter x:Name="SessionLogGridSplitter"
                      Grid.Row="4"
                      Height="6"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      ResizeDirection="Rows"
                      ResizeBehavior="PreviousAndNext"
                      ShowsPreview="True"
                      Background="Transparent"
                      ToolTip="برای تغییر ارتفاع گزارش‌ها بکشید"/>

        <!-- LOG AREA -->

        <Grid Grid.Row="5"
              Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LiveNetworkLogColumn"
                                  Width="1.65*"
                                  MinWidth="320"/>
                <ColumnDefinition x:Name="LogPanelSplitterColumn"
                                  Width="6"/>
                <ColumnDefinition x:Name="ImportantApiColumn"
                                  Width="*"
                                  MinWidth="260"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource PanelBorderStyle}"
                    ClipToBounds="True">
                <Expander x:Name="LiveNetworkLogExpander"
                          Header="Live Network Log"
                          Style="{StaticResource PanelExpanderStyle}"
                          IsExpanded="False"
                          AutomationProperties.Name="Live Network Log">
                    <TextBox x:Name="LogTextBox"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             FontSize="12"
                             Padding="5"
                             FlowDirection="LeftToRight"/>
                </Expander>
            </Border>

            <GridSplitter x:Name="LogPanelGridSplitter"
                          Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          ShowsPreview="True"
                          Background="Transparent"
                          ToolTip="برای تغییر عرض گزارش‌ها بکشید"/>

            <Border Grid.Column="2"
                    Style="{StaticResource PanelBorderStyle}"
                    ClipToBounds="True">
                <Expander x:Name="ImportantApiExpander"
                          Header="Important API"
                          Style="{StaticResource PanelExpanderStyle}"
                          IsExpanded="False"
                          AutomationProperties.Name="Important API">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBox x:Name="ImportantApiTextBox"
                                 Grid.Row="0"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 Padding="5"
                                 FlowDirection="LeftToRight"/>

                        <Button x:Name="ClearImportantButton"
                                Grid.Row="1"
                                Content="پاک کردن Important API"
                                MinHeight="32"
                                Margin="0,6,0,0"
                                Padding="10,4"
                                FlowDirection="RightToLeft"
                                Click="ClearImportantButton_Click"/>
                    </Grid>
                </Expander>
            </Border>
        </Grid>
    </Grid>
</Window>
