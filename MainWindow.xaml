 <Window x:Class="FastOrder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="FastOrder"
        Height="950"
        Width="1450">

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="330"/>
        </Grid.RowDefinitions>

        <!-- ================================================= -->
        <!-- TOP BAR -->
        <!-- ================================================= -->

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="0,0,0,10">

            <Button x:Name="LoginButton"
                    Content="ورود به EasyTrader"
                    Width="160"
                    Height="36"
                    Margin="0,0,10,0"
                    Click="LoginButton_Click"/>

            <Button x:Name="MonitoringButton"
                    Content="فعال‌سازی Monitoring"
                    Width="170"
                    Height="36"
                    Margin="0,0,10,0"
                    Click="MonitoringButton_Click"/>

            <Button x:Name="PauseButton"
                    Content="Pause Log"
                    Width="110"
                    Height="36"
                    Margin="0,0,10,0"
                    Click="PauseButton_Click"/>

            <Button x:Name="ClearButton"
                    Content="Clear Log"
                    Width="110"
                    Height="36"
                    Margin="0,0,10,0"
                    Click="ClearButton_Click"/>

            <Button x:Name="ReloadButton"
                    Content="بارگذاری مجدد"
                    Width="130"
                    Height="36"
                    Margin="0,0,10,0"
                    Click="ReloadButton_Click"/>

            <TextBlock x:Name="StatusTextBlock"
                       Text="در حال آماده‌سازی..."
                       VerticalAlignment="Center"
                       Margin="15,0,0,0"
                       FontSize="15"/>

        </StackPanel>

        <!-- ================================================= -->
        <!-- WEBVIEW -->
        <!-- ================================================= -->

        <wv2:WebView2 x:Name="Browser"
                      Grid.Row="1"
                      NavigationStarting="Browser_NavigationStarting"
                      NavigationCompleted="Browser_NavigationCompleted"/>

        <!-- ================================================= -->
        <!-- LOG AREA -->
        <!-- ================================================= -->

        <Grid Grid.Row="2"
              Margin="0,10,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1.3*"/>
            </Grid.ColumnDefinitions>

            <!-- ================================================= -->
            <!-- LIVE LOG -->
            <!-- ================================================= -->

            <GroupBox Grid.Column="0"
                      Header="Live Network Log"
                      Margin="0,0,5,0">

                <TextBox x:Name="LogTextBox"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         FontSize="12"
                         Padding="5"/>

            </GroupBox>

            <!-- ================================================= -->
            <!-- IMPORTANT API -->
            <!-- ================================================= -->

            <GroupBox Grid.Column="1"
                      Header="Important API"
                      Margin="5,0,0,0">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBox x:Name="ImportantApiTextBox"
                             Grid.Row="0"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             FontSize="12"
                             Padding="5"/>

                    <Button x:Name="ClearImportantButton"
                            Grid.Row="1"
                            Content="پاک کردن Important API"
                            Height="30"
                            Margin="5"
                            Click="ClearImportantButton_Click"/>

                </Grid>

            </GroupBox>

        </Grid>

    </Grid>

</Window>

