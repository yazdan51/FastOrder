<Window x:Class="FastOrder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="FastOrder"
        Width="1280"
        Height="720"
        MinWidth="1040"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#FFF3F5F7"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <Style x:Key="SectionTitleStyle"
               TargetType="TextBlock">
            <Setter Property="Margin"
                    Value="0,2,0,10"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Foreground"
                    Value="#FF263238"/>
        </Style>

        <Style x:Key="ControlButtonStyle"
               TargetType="Button">
            <Setter Property="MinHeight"
                    Value="38"/>
            <Setter Property="Margin"
                    Value="0,0,0,8"/>
            <Setter Property="Padding"
                    Value="12,6"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
        </Style>

        <Style x:Key="PanelBorderStyle"
               TargetType="Border">
            <Setter Property="Background"
                    Value="White"/>
            <Setter Property="BorderBrush"
                    Value="#FFD7DDE3"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="CornerRadius"
                    Value="6"/>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Background"
                    Value="White"/>
            <Setter Property="BorderBrush"
                    Value="#FFD7DDE3"/>
            <Setter Property="Padding"
                    Value="6"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Padding"
                    Value="8,6"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding"
                    Value="8,5"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"
                           MinHeight="220"/>
            <RowDefinition Height="6"/>
            <RowDefinition x:Name="SessionAreaRow"
                           Height="150"
                           MinHeight="120"
                           MaxHeight="300"/>
            <RowDefinition Height="6"/>
            <RowDefinition x:Name="LogAreaRow"
                           Height="190"
                           MinHeight="120"
                           MaxHeight="380"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->

        <Border Grid.Row="0"
                Margin="0,0,0,10"
                Padding="14,10"
                Style="{StaticResource PanelBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Margin="0,0,24,0">
                    <TextBlock Text="FastOrder"
                               FontSize="21"
                               FontWeight="SemiBold"
                               Foreground="#FF17212B"/>
                    <TextBlock x:Name="BrokerRouteTextBlock"
                               Text="مسیر رسمی کارگزاری انتخاب‌شده"
                               Margin="0,2,0,0"
                               FlowDirection="RightToLeft"
                               Foreground="#FF607D8B"
                               FontSize="12"/>
                </StackPanel>

                <TextBlock x:Name="StatusTextBlock"
                           Grid.Column="1"
                           Text="در حال آماده‌سازی..."
                           FlowDirection="RightToLeft"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Center"
                           TextAlignment="Right"
                           TextWrapping="Wrap"
                           FontSize="15"
                           Foreground="#FF263238"/>

                <StackPanel Grid.Column="2"
                            Margin="22,0,0,0"
                            VerticalAlignment="Center"
                            FlowDirection="RightToLeft">
                    <TextBlock Text="زمان مرکز معاملات"
                               HorizontalAlignment="Right"
                               FontSize="11"
                               Foreground="#FF607D8B"/>
                    <TextBlock x:Name="ExchangeClockTextBlock"
                               Text="در حال همگام‌سازی..."
                               Margin="0,2,0,0"
                               MinWidth="205"
                               HorizontalAlignment="Right"
                               TextAlignment="Right"
                               FlowDirection="LeftToRight"
                               FontFamily="Consolas"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#FFEF6C00"
                               AutomationProperties.Name="زمان مرکز معاملات"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- RESPONSIVE CONTROL PANEL + WEBVIEW -->

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ControlPanelColumn"
                                  Width="300"
                                  MinWidth="260"
                                  MaxWidth="440"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"
                                  MinWidth="460"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="12"
                    Style="{StaticResource PanelBorderStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="True">
                    <StackPanel FlowDirection="RightToLeft">
                        <TextBlock Text="اتصال و نشست"
                                   Style="{StaticResource SectionTitleStyle}"/>

                        <TextBlock Text="کارگزاری:"
                                   Margin="0,0,0,5"
                                   Foreground="#FF455A64"
                                   FontWeight="SemiBold"/>

                        <ComboBox x:Name="BrokerSelectionComboBox"
                                  MinHeight="34"
                                  Margin="0,0,0,8"
                                  Padding="8,4"
                                  DisplayMemberPath="DisplayName"
                                  SelectionChanged="BrokerSelectionComboBox_SelectionChanged"
                                  AutomationProperties.Name="انتخاب کارگزاری"
                                  ToolTip="کارگزاری را پیش از ورود و آماده‌سازی سفارش انتخاب کنید."/>

                        <Button x:Name="LoginButton"
                                Content="ورود به کارگزاری"
                                Style="{StaticResource ControlButtonStyle}"
                                Click="LoginButton_Click"/>

                        <Button x:Name="MonitoringButton"
                                Content="فعال‌سازی Monitoring"
                                Style="{StaticResource ControlButtonStyle}"
                                Click="MonitoringButton_Click"/>

                        <Button x:Name="LoginStatusButton"
                                Content="وضعیت ورود"
                                Style="{StaticResource ControlButtonStyle}"
                                Click="LoginStatusButton_Click"/>

                        <Button x:Name="ReloadButton"
                                Content="بارگذاری مجدد"
                                Style="{StaticResource ControlButtonStyle}"
                                Click="ReloadButton_Click"/>

                        <Separator Margin="0,5,0,10"/>

                        <TextBlock Text="فرم و سفارش"
                                   Style="{StaticResource SectionTitleStyle}"/>

                        <Border Margin="0,0,0,10"
                                Padding="10"
                                Background="#FFF8FAFB"
                                BorderBrush="#FFD7DDE3"
                                BorderThickness="1"
                                CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="تنظیم فعلی سفارش"
                                           Margin="0,0,0,8"
                                           FontWeight="SemiBold"
                                           Foreground="#FF263238"/>

                                <TextBlock x:Name="CurrentSetupStateTextBlock"
                                           Text="هنوز سفارشی خوانده و تأیید نشده است."
                                           Margin="0,0,0,8"
                                           TextWrapping="Wrap"
                                           Foreground="#FF607D8B"
                                           FontSize="12"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Grid.Column="0"
                                               Text="نماد:"
                                               Margin="0,2,0,2"
                                               FontWeight="SemiBold"/>
                                    <TextBlock x:Name="CurrentSetupSymbolTextBlock"
                                               Grid.Row="0"
                                               Grid.Column="1"
                                               Text="—"
                                               Margin="8,2,0,2"
                                               TextTrimming="CharacterEllipsis"/>

                                    <TextBlock Grid.Row="1"
                                               Grid.Column="0"
                                               Text="ISIN:"
                                               Margin="0,2,0,2"
                                               FontWeight="SemiBold"/>
                                    <TextBlock x:Name="CurrentSetupIsinTextBlock"
                                               Grid.Row="1"
                                               Grid.Column="1"
                                               Text="—"
                                               Margin="8,2,0,2"
                                               FlowDirection="LeftToRight"
                                               TextAlignment="Right"/>

                                    <TextBlock Grid.Row="2"
                                               Grid.Column="0"
                                               Text="قیمت:"
                                               Margin="0,2,0,2"
                                               FontWeight="SemiBold"/>
                                    <TextBlock x:Name="CurrentSetupPriceTextBlock"
                                               Grid.Row="2"
                                               Grid.Column="1"
                                               Text="—"
                                               Margin="8,2,0,2"/>

                                    <TextBlock Grid.Row="3"
                                               Grid.Column="0"
                                               Text="تعداد کل:"
                                               Margin="0,2,0,2"
                                               FontWeight="SemiBold"/>
                                    <TextBlock x:Name="CurrentSetupQuantityTextBlock"
                                               Grid.Row="3"
                                               Grid.Column="1"
                                               Text="—"
                                               Margin="8,2,0,2"/>

                                    <TextBlock Grid.Row="4"
                                               Grid.Column="0"
                                               Text="کارمزد:"
                                               Margin="0,2,0,2"
                                               FontWeight="SemiBold"/>
                                    <TextBlock x:Name="CurrentSetupCommissionTextBlock"
                                               Grid.Row="4"
                                               Grid.Column="1"
                                               Text="—"
                                               Margin="8,2,0,2"/>

                                    <TextBlock Grid.Row="5"
                                               Grid.Column="0"
                                               Text="ارزش نهایی:"
                                               Margin="0,2,0,2"
                                               FontWeight="SemiBold"/>
                                    <TextBlock x:Name="CurrentSetupTotalValueTextBlock"
                                               Grid.Row="5"
                                               Grid.Column="1"
                                               Text="—"
                                               Margin="8,2,0,2"
                                               FontWeight="SemiBold"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Button x:Name="PreviewOrderButton"
                                Content="باز کردن فرم نماد جاری"
                                Style="{StaticResource ControlButtonStyle}"
                                ToolTip="فرم رسمی خرید نماد جاری EasyTrader را باز می‌کند؛ ارسال انجام نمی‌شود."
                                Click="PreviewOrderButton_Click"/>

                        <Button x:Name="ReadOrderFormButton"
                                Content="خواندن و تأیید فرم"
                                Style="{StaticResource ControlButtonStyle}"
                                IsEnabled="False"
                                ToolTip="نماد، ISIN، قیمت و تعداد را از فرم رسمی می‌خواند؛ ارسال انجام نمی‌شود."
                                Click="ReadOrderFormButton_Click"/>

                        <Button x:Name="PrepareOrderButton"
                                Content="آماده‌سازی محلی"
                                Style="{StaticResource ControlButtonStyle}"
                                IsEnabled="False"
                                ToolTip="Payload و ترافیک طبیعی سایت را کنترل می‌کند؛ هیچ سفارشی ارسال نمی‌شود."
                                Click="PrepareOrderButton_Click"/>

                        <Button x:Name="SendLiveOrderButton"
                                Content="افزودن به زمان‌بندی"
                                Style="{StaticResource ControlButtonStyle}"
                                IsEnabled="False"
                                Background="#FFC62828"
                                BorderBrush="#FFB71C1C"
                                Foreground="White"
                                FontWeight="SemiBold"
                                ToolTip="پس از تأیید نهایی، در بازه تعیین‌شده تا اولین پاسخ موفق تلاش می‌کند."
                                Click="SendLiveOrderButton_Click"/>

                        <Button x:Name="CancelScheduledOrderButton"
                                Content="لغو نشست انتخاب‌شده"
                                Style="{StaticResource ControlButtonStyle}"
                                IsEnabled="False"
                                Background="#FF616161"
                                BorderBrush="#FF424242"
                                Foreground="White"
                                ToolTip="تلاش‌های بعدی را لغو می‌کند؛ عملیات ارسال‌شده قابل بازگردانی نیست."
                                Click="CancelScheduledOrderButton_Click"/>

                        <Separator Margin="0,5,0,10"/>

                        <TextBlock Text="ابزارهای بررسی"
                                   Style="{StaticResource SectionTitleStyle}"/>

                        <Button x:Name="WebViewTimingTestButton"
                                Content="تست زمان‌بندی WebView2"
                                Style="{StaticResource ControlButtonStyle}"
                                ToolTip="فقط زمان اجرای JavaScript را اندازه‌گیری می‌کند؛ هیچ کلیک، POST یا تغییر فرم انجام نمی‌شود."
                                Click="WebViewTimingTestButton_Click"/>

                        <Button x:Name="BrokerCompatibilityProbeButton"
                                Content="بررسی ساختاری کارگزاری"
                                Style="{StaticResource ControlButtonStyle}"
                                ToolTip="فقط مشخصات ساختاری کنترل‌های قابل‌مشاهده را بدون خواندن مقدار فیلد، Token، Cookie، Header یا Body گزارش می‌کند."
                                Click="BrokerCompatibilityProbeButton_Click"/>

                        <Button x:Name="OrderUiDryRunTimingButton"
                                Content="Dry-Run فرم سفارش"
                                Style="{StaticResource ControlButtonStyle}"
                                ToolTip="فرم رسمی را پیدا و قیمت/تعداد تأییدشده را تنظیم می‌کند، اما دکمه ارسال خرید را هرگز کلیک نمی‌کند."
                                Click="OrderUiDryRunTimingButton_Click"/>

                        <Separator Margin="0,5,0,10"/>

                        <TextBlock Text="نمایش گزارش"
                                   Style="{StaticResource SectionTitleStyle}"/>

                        <Button x:Name="PauseButton"
                                Content="Pause Log"
                                Style="{StaticResource ControlButtonStyle}"
                                Click="PauseButton_Click"/>

                        <Button x:Name="ClearButton"
                                Content="Clear Log"
                                Style="{StaticResource ControlButtonStyle}"
                                Click="ClearButton_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          ShowsPreview="True"
                          Background="Transparent"
                          ToolTip="برای تغییر عرض پنل کنترل بکشید"/>

            <Border Grid.Column="2"
                    Style="{StaticResource PanelBorderStyle}"
                    ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Padding="12,8"
                            Background="#FFF8FAFB"
                            BorderBrush="#FFD7DDE3"
                            BorderThickness="0,0,0,1">
                        <TextBlock x:Name="BrokerWebViewTitleTextBlock"
                                   Text="کارگزاری انتخاب‌شده"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#FF263238"/>
                    </Border>

                    <wv2:WebView2 x:Name="Browser"
                                  Grid.Row="1"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  NavigationStarting="Browser_NavigationStarting"
                                  NavigationCompleted="Browser_NavigationCompleted"/>

                    <Border x:Name="OfficialUiDispatcherOverlay"
                            Grid.Row="1"
                            Panel.ZIndex="10"
                            Background="#990B1720"
                            Visibility="Collapsed"
                            AutomationProperties.Name="عملیات کنترل‌شده کارگزاری">
                        <Border HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Padding="24,16"
                                CornerRadius="8"
                                Background="#EFFFFFFF">
                            <StackPanel HorizontalAlignment="Center">
                                <ProgressBar Width="220"
                                             Height="5"
                                             IsIndeterminate="True"/>
                                <TextBlock x:Name="OfficialUiDispatcherOverlayText"
                                           Margin="0,12,0,0"
                                           Text="در حال اجرای عملیات رسمی کارگزاری..."
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#FF263238"/>
                            </StackPanel>
                        </Border>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <GridSplitter Grid.Row="2"
                      Height="6"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      ResizeDirection="Rows"
                      ResizeBehavior="PreviousAndNext"
                      ShowsPreview="True"
                      Background="Transparent"
                      ToolTip="برای تغییر ارتفاع فهرست نشست‌ها بکشید"/>

        <!-- ORDER SESSIONS -->

        <Border Grid.Row="3"
                Margin="0,4,0,0"
                Style="{StaticResource PanelBorderStyle}"
                ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Margin="12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="نشست‌های سفارش"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#FF263238"/>

                    <TextBlock Grid.Column="1"
                               Text="Stage 79 — اجرای هم‌زمان چند نشست برای کارگزاری فعال"
                               HorizontalAlignment="Right"
                               FlowDirection="RightToLeft"
                               Foreground="#FF607D8B"
                               FontSize="12"/>
                </Grid>

                <DataGrid x:Name="SessionDataGrid"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="True"
                          CanUserResizeColumns="True"
                          CanUserResizeRows="False"
                          EnableRowVirtualization="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0,1,0,0"
                          BorderBrush="#FFD7DDE3"
                          RowHeaderWidth="0"
                          AlternatingRowBackground="#FFF8FAFB"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          FlowDirection="RightToLeft"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          SelectionChanged="SessionDataGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#"
                                            Binding="{Binding CreationSequence}"
                                            Width="48"/>
                        <DataGridTextColumn Header="کارگزاری"
                                            Binding="{Binding BrokerDisplayName}"
                                            MinWidth="110"
                                            Width="Auto"/>
                        <DataGridTextColumn Header="نماد"
                                            Binding="{Binding SymbolName}"
                                            MinWidth="145"
                                            Width="1.4*"/>
                        <DataGridTextColumn Header="وضعیت"
                                            Binding="{Binding StateDisplay}"
                                            MinWidth="105"
                                            Width="Auto"/>
                        <DataGridTextColumn Header="کل"
                                            Binding="{Binding TotalQuantityDisplay}"
                                            MinWidth="78"
                                            Width="Auto"/>
                        <DataGridTextColumn Header="ارسال‌شده"
                                            Binding="{Binding SentQuantityDisplay}"
                                            MinWidth="88"
                                            Width="Auto"/>
                        <DataGridTextColumn Header="درحال ارسال"
                                            Binding="{Binding InFlightQuantityDisplay}"
                                            MinWidth="90"
                                            Width="Auto"/>
                        <DataGridTextColumn Header="باقی‌مانده"
                                            Binding="{Binding RemainingQuantityDisplay}"
                                            MinWidth="88"
                                            Width="Auto"/>
                        <DataGridTextColumn Header="سقف"
                                            Binding="{Binding MaxQuantityPerOrderDisplay}"
                                            MinWidth="70"
                                            Width="Auto"/>
                        <DataGridTextColumn Header="شروع"
                                            Binding="{Binding StartTimeDisplay}"
                                            MinWidth="78"
                                            Width="Auto"/>
                        <DataGridTextColumn Header="بعدی"
                                            Binding="{Binding NextDueDisplay}"
                                            MinWidth="100"
                                            Width="Auto"/>
                        <DataGridTextColumn Header="HTTP"
                                            Binding="{Binding LastHttpStatusDisplay}"
                                            MinWidth="64"
                                            Width="Auto"/>
                        <DataGridTextColumn Header="آخرین وضعیت"
                                            Binding="{Binding LastStatus}"
                                            MinWidth="180"
                                            Width="2*"/>
                        <DataGridTemplateColumn Header="عملیات"
                                                MinWidth="190"
                                                Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                FlowDirection="RightToLeft">
                                        <Button Content="مکث"
                                                Margin="2"
                                                Padding="8,3"
                                                ToolTip="فقط ایجاد اسلات جدید این نشست را متوقف می‌کند."
                                                Click="PauseOrderSessionButton_Click"/>
                                        <Button Content="ادامه"
                                                Margin="2"
                                                Padding="8,3"
                                                ToolTip="نشست متوقف را از اولین اسلات آینده ادامه می‌دهد."
                                                Click="ResumeOrderSessionButton_Click"/>
                                        <Button Content="لغو"
                                                Margin="2"
                                                Padding="8,3"
                                                ToolTip="فقط همین نشست را لغو می‌کند؛ کلیک انجام‌شده قابل بازگردانی نیست."
                                                Click="CancelOrderSessionButton_Click"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <GridSplitter Grid.Row="4"
                      Height="6"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      ResizeDirection="Rows"
                      ResizeBehavior="PreviousAndNext"
                      ShowsPreview="True"
                      Background="Transparent"
                      ToolTip="برای تغییر ارتفاع گزارش‌ها بکشید"/>

        <!-- LOG AREA -->

        <Grid Grid.Row="5"
              Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.65*"
                                  MinWidth="320"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"
                                  MinWidth="260"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0"
                      Header="Live Network Log"
                      Margin="0">
                <TextBox x:Name="LogTextBox"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         FontSize="12"
                         Padding="5"
                         FlowDirection="LeftToRight"/>
            </GroupBox>

            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          ShowsPreview="True"
                          Background="Transparent"
                          ToolTip="برای تغییر عرض گزارش‌ها بکشید"/>

            <GroupBox Grid.Column="2"
                      Header="Important API"
                      Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBox x:Name="ImportantApiTextBox"
                             Grid.Row="0"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             FontSize="12"
                             Padding="5"
                             FlowDirection="LeftToRight"/>

                    <Button x:Name="ClearImportantButton"
                            Grid.Row="1"
                            Content="پاک کردن Important API"
                            MinHeight="32"
                            Margin="0,6,0,0"
                            Padding="10,4"
                            FlowDirection="RightToLeft"
                            Click="ClearImportantButton_Click"/>
                </Grid>
            </GroupBox>
        </Grid>
    </Grid>
</Window>
