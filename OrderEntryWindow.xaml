<Window x:Class="FastOrder.OrderEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ورود اطلاعات سفارش"
        Width="560"
        Height="650"
        MinWidth="520"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FlowDirection="RightToLeft">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="اطلاعات سفارش آزمایشی"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Margin="0,0,0,14"/>

        <Border Grid.Row="1"
                Background="#FFE8F3FF"
                BorderBrush="#FF5B9BD5"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12"
                Margin="0,0,0,16">
            <TextBlock Text="در این مرحله فقط Payload ساخته و بررسی می‌شود. هیچ سفارش یا درخواست شبکه‌ای ارسال نخواهد شد."
                       TextWrapping="Wrap"/>
        </Border>

        <Grid Grid.Row="2"
              Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="نام نماد:" VerticalAlignment="Center" Margin="0,5"/>
            <TextBox x:Name="SymbolNameTextBox"
                     Grid.Row="0"
                     Grid.Column="1"
                     Height="32"
                     MaxLength="100"
                     Padding="6,4"
                     Margin="0,4"
                     AutomationProperties.Name="نام نماد"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="ISIN:" VerticalAlignment="Center" Margin="0,5"/>
            <TextBox x:Name="IsinTextBox"
                     Grid.Row="1"
                     Grid.Column="1"
                     Height="32"
                     MaxLength="12"
                     Padding="6,4"
                     Margin="0,4"
                     CharacterCasing="Upper"
                     FlowDirection="LeftToRight"
                     TextAlignment="Left"
                     AutomationProperties.Name="کد ISIN"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="قیمت:" VerticalAlignment="Center" Margin="0,5"/>
            <TextBox x:Name="PriceTextBox"
                     Grid.Row="2"
                     Grid.Column="1"
                     Height="32"
                     MaxLength="20"
                     Padding="6,4"
                     Margin="0,4"
                     FlowDirection="LeftToRight"
                     TextAlignment="Left"
                     AutomationProperties.Name="قیمت سفارش"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="تعداد:" VerticalAlignment="Center" Margin="0,5"/>
            <TextBox x:Name="QuantityTextBox"
                     Grid.Row="3"
                     Grid.Column="1"
                     Height="32"
                     MaxLength="20"
                     Padding="6,4"
                     Margin="0,4"
                     FlowDirection="LeftToRight"
                     TextAlignment="Left"
                     AutomationProperties.Name="تعداد سفارش"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="کد سمت سفارش:" VerticalAlignment="Center" Margin="0,5"/>
            <ComboBox x:Name="SideComboBox"
                      Grid.Row="4"
                      Grid.Column="1"
                      Height="32"
                      Padding="6,2"
                      Margin="0,4"
                      AutomationProperties.Name="کد سمت سفارش">
                <ComboBoxItem Content="کد 0 — مطابق نمونه ثبت‌شده" Tag="0"/>
                <ComboBoxItem Content="کد 1 — نیازمند تأیید پیش از استفاده واقعی" Tag="1"/>
            </ComboBox>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="نرخ کارمزد:" VerticalAlignment="Center" Margin="0,5"/>
            <TextBox Grid.Row="5"
                     Grid.Column="1"
                     Text="0.0012"
                     Height="32"
                     Padding="6,4"
                     Margin="0,4"
                     IsReadOnly="True"
                     FlowDirection="LeftToRight"
                     TextAlignment="Left"
                     AutomationProperties.Name="نرخ کارمزد ثابت"/>

            <TextBlock Grid.Row="6" Grid.Column="0" Text="مبدأ / مدل / اعتبار:" VerticalAlignment="Center" Margin="0,5"/>
            <TextBox Grid.Row="6"
                     Grid.Column="1"
                     Text="34 / 1 / 0"
                     Height="32"
                     Padding="6,4"
                     Margin="0,4"
                     IsReadOnly="True"
                     FlowDirection="LeftToRight"
                     TextAlignment="Left"
                     AutomationProperties.Name="پارامترهای ثابت سفارش"/>

            <TextBlock Grid.Row="7"
                       Grid.Column="0"
                       Grid.ColumnSpan="2"
                       Text="معنای کد سمت سفارش باید پیش از فعال‌سازی ارسال واقعی دوباره با نمونه معتبر تطبیق داده شود."
                       Foreground="#FF7A4E00"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"/>
        </Grid>

        <TextBlock x:Name="ValidationTextBlock"
                   Grid.Row="3"
                   Foreground="#FFC00000"
                   TextWrapping="Wrap"
                   MinHeight="22"
                   Margin="0,0,0,12"
                   AutomationProperties.LiveSetting="Polite"/>

        <Border Grid.Row="4"
                Background="#FFF5F5F5"
                BorderBrush="#FFD0D0D0"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="ارزش ناخالص:" Margin="0,3"/>
                <TextBlock x:Name="GrossValueTextBlock" Grid.Row="0" Grid.Column="1" Margin="0,3"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="مبلغ کارمزد:" Margin="0,3"/>
                <TextBlock x:Name="CommissionAmountTextBlock" Grid.Row="1" Grid.Column="1" Margin="0,3"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="ارزش نهایی:" Margin="0,3" FontWeight="SemiBold"/>
                <TextBlock x:Name="TotalValueTextBlock" Grid.Row="2" Grid.Column="1" Margin="0,3" FontWeight="SemiBold"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    FlowDirection="LeftToRight">
            <Button Content="انصراف"
                    Width="100"
                    Height="36"
                    Margin="0,0,10,0"
                    IsCancel="True"/>

            <Button x:Name="BuildPreviewButton"
                    Content="ساخت پیش‌نمایش"
                    Width="140"
                    Height="36"
                    IsEnabled="False"
                    IsDefault="True"
                    Click="BuildPreviewButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
