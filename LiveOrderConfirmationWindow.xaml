<Window x:Class="FastOrder.LiveOrderConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تأیید ارسال واقعی سفارش"
        Width="620"
        Height="690"
        MinWidth="560"
        MinHeight="650"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="تأیید نهایی ارسال واقعی"
                   FontSize="23"
                   FontWeight="Bold"
                   Margin="0,0,0,14"/>

        <Border Grid.Row="1"
                Background="#FFFFE5E5"
                BorderBrush="#FFC62828"
                BorderThickness="2"
                CornerRadius="5"
                Padding="14"
                Margin="0,0,0,18">
            <TextBlock Text="هشدار: پس از تأیید، برنامه در بازه تعیین‌شده برای ثبت همین سفارش تلاش می‌کند و با اولین پاسخ موفق متوقف می‌شود. پاسخ نامشخص هرگز تکرار نمی‌شود."
                       TextWrapping="Wrap"
                       FontWeight="Bold"
                       Foreground="#FF8E0000"/>
        </Border>

        <Grid Grid.Row="2"
              Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="نماد:" FontWeight="SemiBold" Margin="0,5"/>
            <TextBlock x:Name="SymbolTextBlock" Grid.Row="0" Grid.Column="1" Margin="0,5"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="ISIN:" FontWeight="SemiBold" Margin="0,5"/>
            <TextBlock x:Name="IsinTextBlock" Grid.Row="1" Grid.Column="1" Margin="0,5" FlowDirection="LeftToRight" TextAlignment="Right"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="سمت:" FontWeight="SemiBold" Margin="0,5"/>
            <TextBlock x:Name="SideTextBlock" Grid.Row="2" Grid.Column="1" Margin="0,5" FontWeight="Bold" Foreground="#FF00796B"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="قیمت:" FontWeight="SemiBold" Margin="0,5"/>
            <TextBlock x:Name="PriceTextBlock" Grid.Row="3" Grid.Column="1" Margin="0,5"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="تعداد:" FontWeight="SemiBold" Margin="0,5"/>
            <TextBlock x:Name="QuantityTextBlock" Grid.Row="4" Grid.Column="1" Margin="0,5"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="ارزش ناخالص:" FontWeight="SemiBold" Margin="0,5"/>
            <TextBlock x:Name="GrossValueTextBlock" Grid.Row="5" Grid.Column="1" Margin="0,5"/>

            <TextBlock Grid.Row="6" Grid.Column="0" Text="ارزش نهایی:" FontWeight="SemiBold" Margin="0,5"/>
            <TextBlock x:Name="TotalValueTextBlock" Grid.Row="6" Grid.Column="1" Margin="0,5" FontWeight="Bold"/>

            <TextBlock Grid.Row="7" Grid.Column="0" Text="شناسه محلی:" FontWeight="SemiBold" Margin="0,5"/>
            <TextBlock x:Name="FingerprintTextBlock" Grid.Row="7" Grid.Column="1" Margin="0,5" FlowDirection="LeftToRight" TextAlignment="Right"/>
        </Grid>

        <Border Grid.Row="3"
                BorderBrush="#FFBDBDBD"
                BorderThickness="1"
                CornerRadius="5"
                Padding="12"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="ساعت شروع:"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>
                <TextBox x:Name="StartTimeTextBox"
                         Grid.Row="0" Grid.Column="1"
                         Height="32"
                         VerticalContentAlignment="Center"
                         FlowDirection="LeftToRight"
                         TextAlignment="Center"
                         AutomationProperties.Name="ساعت شروع ارسال"/>

                <TextBlock Grid.Row="0" Grid.Column="3"
                           Text="ساعت پایان:"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>
                <TextBox x:Name="EndTimeTextBox"
                         Grid.Row="0" Grid.Column="4"
                         Height="32"
                         VerticalContentAlignment="Center"
                         FlowDirection="LeftToRight"
                         TextAlignment="Center"
                         AutomationProperties.Name="ساعت پایان ارسال"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5"
                           Text="قالب ساعت: HH:mm یا HH:mm:ss — بازه باید در همین روز و حداکثر ۸ ساعت باشد. اگر شروع گذشته باشد، عملیات فوراً آغاز می‌شود."
                           Margin="0,8,0,0"
                           Foreground="#FF555555"
                           TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <CheckBox x:Name="FinalConfirmationCheckBox"
                  Grid.Row="4"
                  Content="اطلاعات و بازه زمانی را بررسی کردم و تلاش خودکار برای ثبت همین یک سفارش را تأیید می‌کنم."
                  Margin="0,0,0,18"
                  FontWeight="SemiBold"
                  Checked="FinalConfirmationCheckBox_Changed"
                  Unchecked="FinalConfirmationCheckBox_Changed"
                  AutomationProperties.Name="تأیید ارسال واقعی سفارش"/>

        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    FlowDirection="LeftToRight">
            <Button Content="انصراف"
                    Width="110"
                    Height="40"
                    Margin="0,0,12,0"
                    IsCancel="True"/>

            <Button x:Name="SubmitButton"
                    Content="تأیید و شروع زمان‌بندی"
                    Width="210"
                    Height="40"
                    IsEnabled="False"
                    IsDefault="True"
                    Background="#FFC62828"
                    Foreground="White"
                    FontWeight="Bold"
                    Click="SubmitButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
