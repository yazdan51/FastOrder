<Window x:Class="FastOrder.LiveOrderConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تأیید ارسال واقعی سفارش"
        Width="620"
        Height="560"
        MinWidth="560"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="تأیید نهایی ارسال واقعی"
                   FontSize="23"
                   FontWeight="Bold"
                   Margin="0,0,0,14"/>

        <Border Grid.Row="1"
                Background="#FFFFE5E5"
                BorderBrush="#FFC62828"
                BorderThickness="2"
                CornerRadius="5"
                Padding="14"
                Margin="0,0,0,18">
            <TextBlock Text="هشدار: دکمه نهایی این پنجره، دکمه رسمی «ارسال خرید» در EasyTrader را یک‌بار فعال می‌کند و می‌تواند یک سفارش واقعی ایجاد کند."
                       TextWrapping="Wrap"
                       FontWeight="Bold"
                       Foreground="#FF8E0000"/>
        </Border>

        <Grid Grid.Row="2"
              Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="نماد:" FontWeight="SemiBold" Margin="0,5"/>
            <TextBlock x:Name="SymbolTextBlock" Grid.Row="0" Grid.Column="1" Margin="0,5"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="ISIN:" FontWeight="SemiBold" Margin="0,5"/>
            <TextBlock x:Name="IsinTextBlock" Grid.Row="1" Grid.Column="1" Margin="0,5" FlowDirection="LeftToRight" TextAlignment="Right"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="سمت:" FontWeight="SemiBold" Margin="0,5"/>
            <TextBlock x:Name="SideTextBlock" Grid.Row="2" Grid.Column="1" Margin="0,5" FontWeight="Bold" Foreground="#FF00796B"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="قیمت:" FontWeight="SemiBold" Margin="0,5"/>
            <TextBlock x:Name="PriceTextBlock" Grid.Row="3" Grid.Column="1" Margin="0,5"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="تعداد:" FontWeight="SemiBold" Margin="0,5"/>
            <TextBlock x:Name="QuantityTextBlock" Grid.Row="4" Grid.Column="1" Margin="0,5"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="ارزش ناخالص:" FontWeight="SemiBold" Margin="0,5"/>
            <TextBlock x:Name="GrossValueTextBlock" Grid.Row="5" Grid.Column="1" Margin="0,5"/>

            <TextBlock Grid.Row="6" Grid.Column="0" Text="ارزش نهایی:" FontWeight="SemiBold" Margin="0,5"/>
            <TextBlock x:Name="TotalValueTextBlock" Grid.Row="6" Grid.Column="1" Margin="0,5" FontWeight="Bold"/>

            <TextBlock Grid.Row="7" Grid.Column="0" Text="شناسه محلی:" FontWeight="SemiBold" Margin="0,5"/>
            <TextBlock x:Name="FingerprintTextBlock" Grid.Row="7" Grid.Column="1" Margin="0,5" FlowDirection="LeftToRight" TextAlignment="Right"/>
        </Grid>

        <CheckBox x:Name="FinalConfirmationCheckBox"
                  Grid.Row="3"
                  Content="اطلاعات بالا را بررسی کردم و ارسال واقعی همین یک سفارش را تأیید می‌کنم."
                  Margin="0,0,0,18"
                  FontWeight="SemiBold"
                  Checked="FinalConfirmationCheckBox_Changed"
                  Unchecked="FinalConfirmationCheckBox_Changed"
                  AutomationProperties.Name="تأیید ارسال واقعی سفارش"/>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    FlowDirection="LeftToRight">
            <Button Content="انصراف"
                    Width="110"
                    Height="40"
                    Margin="0,0,12,0"
                    IsCancel="True"/>

            <Button x:Name="SubmitButton"
                    Content="ارسال یک سفارش واقعی"
                    Width="190"
                    Height="40"
                    IsEnabled="False"
                    IsDefault="True"
                    Background="#FFC62828"
                    Foreground="White"
                    FontWeight="Bold"
                    Click="SubmitButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
