<Window x:Class="FastOrder.LiveOrderConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تأیید ارسال واقعی سفارش"
        Width="660"
        Height="760"
        MinWidth="580"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        FlowDirection="RightToLeft">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="True"
                      Margin="0,0,0,14">

            <StackPanel>
                <TextBlock Text="تأیید نهایی ارسال واقعی"
                           FontSize="23"
                           FontWeight="Bold"
                           Margin="0,0,0,14"/>

                <Border Background="#FFFFE5E5"
                        BorderBrush="#FFC62828"
                        BorderThickness="2"
                        CornerRadius="5"
                        Padding="12"
                        Margin="0,0,0,14">
                    <TextBlock Text="هشدار: حجم کل به چند سفارش با سقف تعیین‌شده تقسیم می‌شود. برنامه در slotهای یک‌ثانیه‌ای بدون انتظار برای پاسخ HTTP قبلی تلاش می‌کند بخش بعدی را ارسال کند. حجم فقط پس از کلیک رسمی ارسال، ارسال‌شده محسوب می‌شود و پس از آن retry خودکار انجام نمی‌شود."
                               TextWrapping="Wrap"
                               FontWeight="Bold"
                               Foreground="#FF8E0000"/>
                </Border>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="نماد:" FontWeight="SemiBold" Margin="0,4"/>
                    <TextBlock x:Name="SymbolTextBlock" Grid.Row="0" Grid.Column="1" Margin="0,4"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="ISIN:" FontWeight="SemiBold" Margin="0,4"/>
                    <TextBlock x:Name="IsinTextBlock" Grid.Row="1" Grid.Column="1" Margin="0,4"
                               FlowDirection="LeftToRight" TextAlignment="Right"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="سمت:" FontWeight="SemiBold" Margin="0,4"/>
                    <TextBlock x:Name="SideTextBlock" Grid.Row="2" Grid.Column="1" Margin="0,4"
                               FontWeight="Bold" Foreground="#FF00796B"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="قیمت:" FontWeight="SemiBold" Margin="0,4"/>
                    <TextBlock x:Name="PriceTextBlock" Grid.Row="3" Grid.Column="1" Margin="0,4"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="تعداد کل:" FontWeight="SemiBold" Margin="0,4"/>
                    <TextBlock x:Name="QuantityTextBlock" Grid.Row="4" Grid.Column="1" Margin="0,4"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="ارزش ناخالص:" FontWeight="SemiBold" Margin="0,4"/>
                    <TextBlock x:Name="GrossValueTextBlock" Grid.Row="5" Grid.Column="1" Margin="0,4"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="ارزش نهایی:" FontWeight="SemiBold" Margin="0,4"/>
                    <TextBlock x:Name="TotalValueTextBlock" Grid.Row="6" Grid.Column="1" Margin="0,4"
                               FontWeight="Bold"/>

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="شناسه محلی:" FontWeight="SemiBold" Margin="0,4"/>
                    <TextBlock x:Name="FingerprintTextBlock" Grid.Row="7" Grid.Column="1" Margin="0,4"
                               FlowDirection="LeftToRight" TextAlignment="Right"/>
                </Grid>

                <Border BorderBrush="#FFBDBDBD"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="12"
                        Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Grid.Column="0"
                                Grid.ColumnSpan="5"
                                Margin="0,0,0,12"
                                Padding="9,7"
                                Background="#FFE8F5E9"
                                BorderBrush="#FF81C784"
                                BorderThickness="1"
                                CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="مرجع زمان‌بندی: ساعت سرور عمومی مرکز معاملات بورس"
                                           FontWeight="SemiBold"
                                           Foreground="#FF1B5E20"
                                           TextWrapping="Wrap"/>
                                <TextBlock x:Name="ExchangeClockTextBlock"
                                           Margin="0,4,0,0"
                                           FlowDirection="LeftToRight"
                                           TextAlignment="Right"
                                           FontFamily="Consolas"
                                           Foreground="#FF263238"
                                           AutomationProperties.Name="زمان همگام‌شده مرکز معاملات"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="ساعت شروع:"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"/>
                        <TextBox x:Name="StartTimeTextBox"
                                 Grid.Row="1" Grid.Column="1"
                                 Height="32"
                                 VerticalContentAlignment="Center"
                                 FlowDirection="LeftToRight"
                                 TextAlignment="Center"
                                 AutomationProperties.Name="ساعت شروع ارسال"/>

                        <TextBlock Grid.Row="1" Grid.Column="3"
                                   Text="ساعت پایان:"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"/>
                        <TextBox x:Name="EndTimeTextBox"
                                 Grid.Row="1" Grid.Column="4"
                                 Height="32"
                                 VerticalContentAlignment="Center"
                                 FlowDirection="LeftToRight"
                                 TextAlignment="Center"
                                 AutomationProperties.Name="ساعت پایان ارسال"/>

                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Text="سقف هر سفارش:"
                                   Margin="0,10,0,0"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"/>
                        <TextBox x:Name="MaxQuantityPerOrderTextBox"
                                 Grid.Row="2" Grid.Column="1"
                                 Height="32"
                                 Margin="0,10,0,0"
                                 VerticalContentAlignment="Center"
                                 FlowDirection="LeftToRight"
                                 TextAlignment="Center"
                                 AutomationProperties.Name="حداکثر حجم هر سفارش"/>

                        <TextBlock Grid.Row="2" Grid.Column="3"
                                   Text="فاصله ارسال:"
                                   Margin="0,10,0,0"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="2" Grid.Column="4"
                                   Text="۱ ثانیه"
                                   Margin="0,10,0,0"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="5"
                                   Text="قالب ساعت: HH:mm یا HH:mm:ss — شروع، پایان و slotها بر اساس ساعت مرکز معاملات هستند. اگر این ساعت معتبر یا تازه نباشد، ارسال متوقف می‌شود."
                                   Margin="0,9,0,0"
                                   Foreground="#FF555555"
                                   TextWrapping="Wrap"/>
                    </Grid>
                </Border>

                <CheckBox x:Name="FinalConfirmationCheckBox"
                          Margin="0,0,0,8"
                          FontWeight="SemiBold"
                          Checked="FinalConfirmationCheckBox_Changed"
                          Unchecked="FinalConfirmationCheckBox_Changed"
                          AutomationProperties.Name="تأیید ارسال واقعی سفارش">
                    <TextBlock Text="اطلاعات، حجم کل، سقف هر سفارش و بازه زمانی را بررسی کردم و ارسال پله‌ای سفارش‌ها را تأیید می‌کنم."
                               TextWrapping="Wrap"/>
                </CheckBox>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1"
                Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                Padding="0,10,0,0">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        FlowDirection="LeftToRight">
                <Button Content="انصراف"
                        Width="110"
                        Height="40"
                        Margin="0,0,12,0"
                        IsCancel="True"/>

                <Button x:Name="SubmitButton"
                        Content="تأیید و شروع ارسال پله‌ای"
                        Width="210"
                        Height="40"
                        IsEnabled="False"
                        IsDefault="True"
                        Background="#FFC62828"
                        Foreground="White"
                        FontWeight="Bold"
                        Click="SubmitButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
