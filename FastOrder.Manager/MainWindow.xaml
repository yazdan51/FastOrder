<Window x:Class="FastOrder.Manager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FastOrder Manager"
        Width="760"
        Height="330"
        MinWidth="680"
        MinHeight="300"
        WindowStartupLocation="CenterScreen"
        Closing="MainWindow_Closing">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="78" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="10,6" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid x:Name="ManagerControls" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Text="FastOrder Manager" />

        <Border Grid.Row="2"
                BorderBrush="#D0D7DE"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="42" />
                    <RowDefinition Height="52" />
                    <RowDefinition Height="52" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Grid.ColumnSpan="6"
                        Background="#F6F8FA" />

                <TextBlock Grid.Row="0" Grid.Column="0" Margin="12,0" FontWeight="SemiBold" Text="Instance ID" />
                <TextBlock Grid.Row="0" Grid.Column="1" Margin="12,0" FontWeight="SemiBold" Text="Status" />
                <TextBlock Grid.Row="0" Grid.Column="2" Margin="12,0" FontWeight="SemiBold" Text="PID" />
                <TextBlock Grid.Row="0" Grid.Column="3" HorizontalAlignment="Center" FontWeight="SemiBold" Text="Start" />
                <TextBlock Grid.Row="0" Grid.Column="4" HorizontalAlignment="Center" FontWeight="SemiBold" Text="Stop" />
                <TextBlock Grid.Row="0" Grid.Column="5" HorizontalAlignment="Center" FontWeight="SemiBold" Text="Restart" />

                <TextBlock Grid.Row="1" Grid.Column="0" Margin="12,0" Text="1" />
                <TextBlock x:Name="Instance1StatusText" Grid.Row="1" Grid.Column="1" Margin="12,0" Text="Stopped" />
                <TextBlock x:Name="Instance1PidText" Grid.Row="1" Grid.Column="2" Margin="12,0" Text="—" />
                <Button x:Name="Instance1StartButton" Grid.Row="1" Grid.Column="3" Tag="1" Content="Start" Click="StartInstanceButton_Click" />
                <Button x:Name="Instance1StopButton" Grid.Row="1" Grid.Column="4" Tag="1" Content="Stop" Click="StopInstanceButton_Click" />
                <Button x:Name="Instance1RestartButton" Grid.Row="1" Grid.Column="5" Tag="1" Content="Restart" Click="RestartInstanceButton_Click" />

                <Separator Grid.Row="2"
                           Grid.ColumnSpan="6"
                           VerticalAlignment="Top" />
                <TextBlock Grid.Row="2" Grid.Column="0" Margin="12,0" Text="2" />
                <TextBlock x:Name="Instance2StatusText" Grid.Row="2" Grid.Column="1" Margin="12,0" Text="Stopped" />
                <TextBlock x:Name="Instance2PidText" Grid.Row="2" Grid.Column="2" Margin="12,0" Text="—" />
                <Button x:Name="Instance2StartButton" Grid.Row="2" Grid.Column="3" Tag="2" Content="Start" Click="StartInstanceButton_Click" />
                <Button x:Name="Instance2StopButton" Grid.Row="2" Grid.Column="4" Tag="2" Content="Stop" Click="StopInstanceButton_Click" />
                <Button x:Name="Instance2RestartButton" Grid.Row="2" Grid.Column="5" Tag="2" Content="Restart" Click="RestartInstanceButton_Click" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="4"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Content="Start All"
                    MinWidth="100"
                    Click="StartAllButton_Click" />
            <Button Content="Stop All"
                    MinWidth="100"
                    Click="StopAllButton_Click" />
        </StackPanel>
    </Grid>
</Window>
