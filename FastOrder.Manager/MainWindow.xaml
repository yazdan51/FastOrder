<Window x:Class="FastOrder.Manager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FastOrder Manager"
        Width="780"
        Height="430"
        MinWidth="700"
        MinHeight="340"
        WindowStartupLocation="CenterScreen"
        Closing="MainWindow_Closing">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="78" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="10,6" />
        </Style>
    </Window.Resources>

    <Grid x:Name="ManagerControls" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Text="FastOrder Manager" />

        <DataGrid x:Name="InstanceGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  CanUserResizeRows="False"
                  HeadersVisibility="Column"
                  IsReadOnly="True"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Width="100"
                                    Header="Instance ID"
                                    Binding="{Binding InstanceId}" />
                <DataGridTextColumn Width="110"
                                    Header="Status"
                                    Binding="{Binding Status}" />
                <DataGridTextColumn Width="90"
                                    Header="PID"
                                    Binding="{Binding ProcessId}" />

                <DataGridTemplateColumn Width="*" Header="Start">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Start"
                                    IsEnabled="{Binding CanStart}"
                                    Click="StartInstanceButton_Click" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="*" Header="Stop">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Stop"
                                    IsEnabled="{Binding CanStop}"
                                    Click="StopInstanceButton_Click" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="*" Header="Restart">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Restart"
                                    IsEnabled="{Binding CanRestart}"
                                    Click="RestartInstanceButton_Click" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="4"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Content="New Instance"
                    MinWidth="110"
                    Click="NewInstanceButton_Click" />
            <Button Content="Start All"
                    MinWidth="100"
                    Click="StartAllButton_Click" />
            <Button Content="Stop All"
                    MinWidth="100"
                    Click="StopAllButton_Click" />
        </StackPanel>
    </Grid>
</Window>
